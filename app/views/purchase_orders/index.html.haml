- content_for :title, t(".heading")

.page__container--wide
  .page__header
    %h1.page__title= t(".heading")
    = link_to t(".add"), new_purchase_order_path, class: "btn--submit"

  - if flash[:notice]
    .alert--notice= flash[:notice]

  = form_with url: purchase_orders_path, method: :get, class: "search-bar" do |form|
    = form.text_field :q, value: params[:q], placeholder: t(".search_placeholder"), class: "search-bar__input"

  - if @purchase_order_presenter.purchase_orders_empty?
    .empty-state= t(".empty")
  - else
    .table__container
      %table.table
        %thead.table__head
          %tr
            %th.table__head-cell= t(".number")
            %th.table__head-cell= t(".supplier")
            %th.table__head-cell= t(".status")
            %th.table__head-cell--numeric= t(".total")
            %th.table__head-cell= t(".date")
        %tbody
          - @purchase_order_presenter.rows.each do |purchase_order|
            %tr.table__row
              %td.table__cell--code= link_to "##{purchase_order[:id]}", purchase_order[:path], class: "link-accent"
              %td.table__cell--primary= purchase_order[:supplier_name]
              %td.table__cell
                %span{class: purchase_order[:status_badge_classes]}= purchase_order[:status_label]
              %td.table__cell--numeric= purchase_order[:total_formatted]
              %td.table__cell= purchase_order[:date_formatted]

    = render "shared/pagination"
