- content_for :title, t(".heading")

.page__container--wide
  .page__header
    %h1.page__title= t(".heading")
    = link_to t(".add"), categories_path(new: true), class: "btn--submit hidden md:inline-flex"

  - if flash[:notice]
    .alert--notice= flash[:notice]

  .split-panel
    .split-panel__list{class: ("hidden md:block" if @show_form)}
      = form_with url: categories_path, method: :get, class: "search-bar" do |form|
        = form.text_field :q, value: params[:q], placeholder: t(".search_placeholder"), class: "search-bar__input"

      - if @categories.empty?
        .empty-state= t(".empty")
      - else
        .table__container
          %table.table
            %thead.table__head
              %tr
                %th.table__head-cell= t(".name")
                %th.table__head-cell
            %tbody
              - @categories.each do |category|
                %tr.table__row
                  %td.table__cell--primary= category.name
                  %td.table__cell= link_to t(".edit"), categories_path(edit: category.id), class: "link-accent"

    .split-panel__form{class: ("hidden md:block" unless @show_form)}
      .panel
        .panel__header
          %h2.panel__title= @category_presenter.form_heading
        = render "form", category: @category

  - unless @show_form
    .mobile-add-bar
      = link_to t(".add"), categories_path(new: true), class: "btn--primary"
