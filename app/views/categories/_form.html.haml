= form_with model: category, url: @category_presenter.form_url, class: "space-y-5" do |form|
  = request_uuid_field
  .field__group
    = form.label :name, t("categories.form.name_label"), class: "field__label"
    = form.text_field :name, value: category.name, required: true, autofocus: true, class: "field__input"

  .form__actions
    = link_to t("categories.form.cancel"), categories_path, class: "btn--secondary"
    = form.submit t("categories.form.submit"), class: "btn--submit"
