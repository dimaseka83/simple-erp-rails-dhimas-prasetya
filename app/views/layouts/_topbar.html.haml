.topbar
  = icon_button css_class: "sidebar-toggle-btn", aria_label: "Toggle navigation", data: { sidebar_toggle: true } do
    %svg.icon-md{xmlns: "http://www.w3.org/2000/svg", viewbox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width" => "1.8", "stroke-linecap" => "round", "stroke-linejoin" => "round"}
      %path{d: "M4 6h16M4 12h16M4 18h16"}

  %h1.topbar-title= content_for(:title) || t("app_name")

  .topbar-actions
    = render "layouts/toolbar_controls"

    %details.dropdown
      %summary.dropdown-trigger
        .avatar= @layout_presenter.current_user_initials
      .dropdown-menu
        .dropdown-header
          %p.dropdown-header-email= @layout_presenter.current_user_email
        %hr.dropdown-divider
        = button_to t("nav.sign_out"), session_path, method: :delete, class: "dropdown-item"
