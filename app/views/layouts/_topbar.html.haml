.topbar
  = icon_button css_class: "sidebar__toggle", aria_label: "Toggle navigation", data: { sidebar_toggle: true } do
    %svg.icon--md{xmlns: "http://www.w3.org/2000/svg", viewbox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width" => "1.8", "stroke-linecap" => "round", "stroke-linejoin" => "round"}
      %path{d: "M4 6h16M4 12h16M4 18h16"}

  %h1.topbar__title= content_for(:title) || t("app_name")

  .topbar__actions
    = render "layouts/toolbar_controls"

    %details.dropdown
      %summary.dropdown__trigger
        .avatar= @layout_presenter.current_user_initials
      .dropdown__menu
        .dropdown__header
          %p.dropdown__email= @layout_presenter.current_user_email
        %hr.dropdown__divider
        = link_to t("settings.edit.heading"), edit_settings_path, class: "dropdown__item"
        = button_to t("nav.sign_out"), session_path, method: :delete, class: "dropdown__item"
