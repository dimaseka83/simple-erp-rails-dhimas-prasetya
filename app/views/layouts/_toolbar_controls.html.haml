.toolbar
  .locale-switcher
    - @layout_presenter.locale_links.each do |locale_link|
      = link_to locale_link[:label], locale_link[:url], class: locale_link[:css_class]

  = icon_button css_class: "theme-toggle-btn", aria_label: "Toggle color theme", data: { theme_toggle: true } do
    %svg{class: "icon-sm theme-icon-dark", xmlns: "http://www.w3.org/2000/svg", viewbox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width" => "2", "stroke-linecap" => "round", "stroke-linejoin" => "round"}
      %circle{cx: "12", cy: "12", r: "4"}
      %path{d: "M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"}
    %svg{class: "icon-sm theme-icon-light", xmlns: "http://www.w3.org/2000/svg", viewbox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width" => "2", "stroke-linecap" => "round", "stroke-linejoin" => "round"}
      %path{d: "M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"}
