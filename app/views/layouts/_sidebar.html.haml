#sidebar.sidebar.-translate-x-full{class: "md:translate-x-0"}
  .sidebar__header
    %span.brand-mark= t("app_name")

  %nav.sidebar__nav
    = link_to root_path, class: @layout_presenter.nav_dashboard_link_classes do
      %svg.nav-link__icon{xmlns: "http://www.w3.org/2000/svg", viewbox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width" => "1.8", "stroke-linecap" => "round", "stroke-linejoin" => "round"}
        %rect{x: "3", y: "3", width: "7", height: "9", rx: "1.5"}
        %rect{x: "14", y: "3", width: "7", height: "5", rx: "1.5"}
        %rect{x: "14", y: "12", width: "7", height: "9", rx: "1.5"}
        %rect{x: "3", y: "16", width: "7", height: "5", rx: "1.5"}
      = t("nav.dashboard")

    .nav__group
      %p.nav__group-label= t("nav.inventory")
      = link_to products_path, class: @layout_presenter.nav_products_link_classes do
        %svg.nav-link__icon{xmlns: "http://www.w3.org/2000/svg", viewbox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width" => "1.8", "stroke-linecap" => "round", "stroke-linejoin" => "round"}
          %path{d: "M21 8l-9-5-9 5 9 5 9-5z"}
          %path{d: "M3 8v8l9 5 9-5V8M12 13v8"}
        = t("nav.products")
      = link_to stock_movements_path, class: @layout_presenter.nav_stock_movements_link_classes do
        %svg.nav-link__icon{xmlns: "http://www.w3.org/2000/svg", viewbox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width" => "1.8", "stroke-linecap" => "round", "stroke-linejoin" => "round"}
          %path{d: "M3 12h4l3 8 4-16 3 8h4"}
        = t("nav.stock_movements")

    .nav__group
      %p.nav__group-label= t("nav.procurement")
      %span.nav-link--soon
        %svg.nav-link__icon{xmlns: "http://www.w3.org/2000/svg", viewbox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width" => "1.8", "stroke-linecap" => "round", "stroke-linejoin" => "round"}
          %path{d: "M3 5h13l3 5v9h-3M16 19H3V5"}
          %circle{cx: "7", cy: "19", r: "1.7"}
          %circle{cx: "17", cy: "19", r: "1.7"}
        = t("nav.suppliers")
        %span.nav-link__badge= t("nav.soon")
      %span.nav-link--soon
        %svg.nav-link__icon{xmlns: "http://www.w3.org/2000/svg", viewbox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width" => "1.8", "stroke-linecap" => "round", "stroke-linejoin" => "round"}
          %path{d: "M9 2h6l1 4H8l1-4zM5 6h14l-1 14H6L5 6zM9 10v6M15 10v6"}
        = t("nav.purchase_orders")
        %span.nav-link__badge= t("nav.soon")

    .nav__group
      %p.nav__group-label= t("nav.sales")
      %span.nav-link--soon
        %svg.nav-link__icon{xmlns: "http://www.w3.org/2000/svg", viewbox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width" => "1.8", "stroke-linecap" => "round", "stroke-linejoin" => "round"}
          %path{d: "M4 4h2l2.4 12.4a2 2 0 0 0 2 1.6h7.2a2 2 0 0 0 2-1.6L21 8H7"}
          %circle{cx: "9", cy: "20", r: "1.3"}
          %circle{cx: "17", cy: "20", r: "1.3"}
        = t("nav.customers")
        %span.nav-link__badge= t("nav.soon")
      %span.nav-link--soon
        %svg.nav-link__icon{xmlns: "http://www.w3.org/2000/svg", viewbox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width" => "1.8", "stroke-linecap" => "round", "stroke-linejoin" => "round"}
          %path{d: "M4 4h16v4H4zM6 8v12h12V8M10 12h4"}
        = t("nav.sales_orders")
        %span.nav-link__badge= t("nav.soon")

.sidebar__backdrop.hidden{class: "md:hidden", "data-sidebar-backdrop" => true}
