- content_for :title, t(".heading")

.page__container--wide
  .page__header
    %h1.page__title= t(".heading")

  - if @stock_movement_presenter.movements_empty?
    .empty-state= t(".empty")
  - else
    .table__container
      %table.table
        %thead.table__head
          %tr
            %th.table__head-cell= t(".date")
            %th.table__head-cell= t(".product")
            %th.table__head-cell= t(".type")
            %th.table__head-cell--numeric= t(".quantity")
            %th.table__head-cell= t(".note")
            %th.table__head-cell= t(".by")
        %tbody
          - @stock_movement_presenter.rows.each do |movement|
            %tr.table__row
              %td.table__cell= movement[:occurred_at]
              %td.table__cell--primary= movement[:product_name]
              %td.table__cell
                %span{class: movement[:type_badge_classes]}= movement[:type_label]
              %td.table__cell--numeric= movement[:quantity_formatted]
              %td.table__cell= movement[:note]
              %td.table__cell= movement[:user_email]

    = render "shared/pagination"
