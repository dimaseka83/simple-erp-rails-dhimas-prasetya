- content_for :title, t(".heading")

.page-container-wide
  .page-header
    %h1.page-title= t(".heading")

  - if @presenter_list.empty?
    .empty-state= t(".empty")
  - else
    .table-container
      %table.data-table
        %thead.data-table-head
          %tr
            %th.data-table-head-cell= t(".date")
            %th.data-table-head-cell= t(".product")
            %th.data-table-head-cell= t(".type")
            %th.data-table-head-cell-numeric= t(".quantity")
            %th.data-table-head-cell= t(".note")
            %th.data-table-head-cell= t(".by")
        %tbody
          - @presenter_list.each do |movement|
            %tr.data-table-row
              %td.data-table-cell= movement.occurred_at
              %td.data-table-cell-primary= movement.product_name
              %td.data-table-cell
                %span{class: movement.type_badge_classes}= movement.type_label
              %td.data-table-cell-numeric= movement.quantity_formatted
              %td.data-table-cell= movement.note
              %td.data-table-cell= movement.user_email
