- content_for :title, t(".heading")

.page-container-wide
  .page-header
    %h1.page-title= t(".heading")
    .toolbar
      = link_to t(".manage_categories"), categories_path, class: "btn-secondary"
      = link_to t(".add"), new_product_path, class: "btn-submit"

  - if flash[:notice]
    .alert-notice= flash[:notice]

  = form_with url: products_path, method: :get, class: "search-bar" do |form|
    = form.text_field :q, value: params[:q], placeholder: t(".search_placeholder"), class: "search-input"

  - if @presenter_list.empty?
    .empty-state
      %p= t(".empty")
      = link_to t(".add"), new_product_path, class: "empty-state-action"
  - else
    .table-container
      %table.data-table
        %thead.data-table-head
          %tr
            %th.data-table-head-cell= t(".name")
            %th.data-table-head-cell= t(".sku")
            %th.data-table-head-cell= t(".category")
            %th.data-table-head-cell= t(".unit")
            %th.data-table-head-cell-numeric= t(".selling_price")
            %th.data-table-head-cell-numeric= t(".stock")
            %th.data-table-head-cell
        %tbody
          - @presenter_list.each do |product|
            %tr.data-table-row
              %td.data-table-cell-primary= link_to product.name, product.path, class: "hover:underline"
              %td.data-table-cell-code= product.sku
              %td.data-table-cell= product.category_name
              %td.data-table-cell= product.unit_label
              %td.data-table-cell-numeric= product.selling_price_formatted
              %td{class: "data-table-cell-numeric #{product.stock_text_classes}"}
                = product.stock_quantity_formatted
              %td.data-table-cell= link_to t("categories.index.edit"), product.edit_path, class: "link-accent"

    = render "shared/pagination"
