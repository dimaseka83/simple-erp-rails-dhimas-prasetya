- content_for :title, t(".heading")

.page__container--wide
  .page__header
    %h1.page__title= t(".heading")
    .toolbar
      = link_to t(".manage_categories"), categories_path, class: "btn--secondary"
      = link_to t(".add"), new_product_path, class: "btn--submit"

  - if flash[:notice]
    .alert--notice= flash[:notice]

  = form_with url: products_path, method: :get, class: "search-bar" do |form|
    = form.text_field :q, value: params[:q], placeholder: t(".search_placeholder"), class: "search-bar__input"

  - if @product_presenter.products_empty?
    .empty-state
      %p= t(".empty")
      = link_to t(".add"), new_product_path, class: "empty-state__action"
  - else
    .table__container
      %table.table
        %thead.table__head
          %tr
            %th.table__head-cell= t(".name")
            %th.table__head-cell= t(".sku")
            %th.table__head-cell= t(".category")
            %th.table__head-cell= t(".unit")
            %th.table__head-cell--numeric= t(".selling_price")
            %th.table__head-cell--numeric= t(".stock")
            %th.table__head-cell
        %tbody
          - @product_presenter.rows.each do |product|
            %tr.table__row
              %td.table__cell--primary= link_to product[:name], product[:path], class: "hover:underline"
              %td.table__cell--code= product[:sku]
              %td.table__cell= product[:category_name]
              %td.table__cell= product[:unit_label]
              %td.table__cell--numeric= product[:selling_price_formatted]
              %td{class: "table__cell--numeric #{product[:stock_text_classes]}"}
                = product[:stock_quantity_formatted]
              %td.table__cell= link_to t("categories.index.edit"), product[:edit_path], class: "link-accent"

    = render "shared/pagination"
