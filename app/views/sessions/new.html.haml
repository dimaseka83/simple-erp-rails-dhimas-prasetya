.auth__page
  .auth__panel
    %span.brand-mark= t("app_name")
    %h1.auth__heading= t(".heading")
    %p.auth__subtitle= t(".subheading")

    - if flash[:alert]
      .alert--error= flash[:alert]
    - if flash[:notice]
      .alert--notice= flash[:notice]

    = form_with url: session_path, class: "auth__form" do |form|
      = request_uuid_field
      .field__group
        = form.label :email_address, t(".email_label"), class: "field__label"
        = form.email_field :email_address,
          required: true, autofocus: true, autocomplete: "username",
          value: params[:email_address], placeholder: t(".email_placeholder"),
          class: "field__input"

      .field__group
        .field__row--between
          = form.label :password, t(".password_label"), class: "field__label"
          = link_to t(".forgot_password"), new_password_path, class: "link-accent"
        = form.password_field :password,
          required: true, autocomplete: "current-password", maxlength: 72, placeholder: t(".password_placeholder"),
          class: "field__input"

      %label.checkbox-field
        = check_box_tag "remember_me", "1", false, class: "checkbox-field__input"
        = t(".remember_me")

      = form.submit t(".submit"), class: "btn--primary"
